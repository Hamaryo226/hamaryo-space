---
/**
 * Callout component for MDX blog posts.
 * 
 * Usage in .mdx files:
 *   import Callout from '../../components/Callout.astro';
 *   <Callout type="info">テキスト</Callout>
 *
 * Types: info | attention | warning | tip
 */
interface Props {
  type?: 'info' | 'attention' | 'warning' | 'tip';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const config = {
  info: {
    label: title ?? 'Info',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`,
  },
  attention: {
    label: title ?? 'Attention',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`,
  },
  warning: {
    label: title ?? 'Warning',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
  },
  tip: {
    label: title ?? 'Tip',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>`,
  },
} as const;

const { label, icon } = config[type];
---

<div class={`callout callout-${type}`}>
  <div class="callout-header">
    <span class="callout-icon" set:html={icon} />
    <span class="callout-label">{label}</span>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</div>
