---
interface Props {
  variant?: 'default' | 'secondary' | 'outline' | 'success' | 'warning' | 'error';
  class?: string;
  [key: string]: any;
}

const { variant = 'outline', class: className = '', ...props } = Astro.props as Props;

const baseClass =
  'inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-medium leading-5 tracking-wide';

const variantClasses = {
  default: 'border-[var(--text)] bg-[var(--text)] text-[var(--bg)]',
  secondary: 'border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text)]',
  outline: 'border-[var(--border)] bg-transparent text-[var(--text-muted)]',
  success: 'border-emerald-600 bg-emerald-600/10 text-emerald-700 dark:text-emerald-300',
  warning: 'border-amber-500 bg-amber-500/10 text-amber-700 dark:text-amber-300',
  error: 'border-rose-600 bg-rose-600/10 text-rose-700 dark:text-rose-300'
};

const badgeClass = [baseClass, variantClasses[variant], className].filter(Boolean).join(' ');
---

<span class={badgeClass} {...props}>
  <slot />
</span>
