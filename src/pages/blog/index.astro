---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Blog — hamaryo" description="hamaryo のブログ。技術メモ・開発の振り返りなど。">
  <section class="container blog-list-section">
    <div class="blog-header reveal">
      <a href="/" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        hamaryo
      </a>
      <h1>Blog</h1>
      <p>技術的なメモや学んだこと、開発の振り返りなど。</p>
    </div>

    {posts.length === 0 ? (
      <div class="blog-empty reveal">
        <p>まだ投稿はありません。</p>
      </div>
    ) : (
      <ul class="blog-post-list reveal">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="blog-post-row">
              <div class="blog-post-main">
                <span class="blog-post-title">{post.data.title}</span>
                <span class="blog-post-desc">{post.data.description}</span>
                <div class="blog-post-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
              <time class="blog-post-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
